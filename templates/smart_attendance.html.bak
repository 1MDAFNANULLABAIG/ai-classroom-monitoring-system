{% extends "base.html" %}
{% block title %}Smart Attendance{% endblock %}
{% block content %}
<h1>🎓 Smart Period Attendance</h1>
<p class="muted">
    Point the camera at the teacher when a period starts — the system identifies who's
    teaching and which period it is from the timetable, then automatically switches to
    recognizing students for that period. Student attendance is <strong>only</strong> ever
    taken once the teacher has been face-confirmed present for that period — including
    during the break before the period starts, no student can be marked until then.
</p>

<div class="panel">
    <h3><i class="fa-solid fa-chalkboard-user" style="color: var(--purple);"></i> Teachers Present Now</h3>
    <p class="muted">Live — updates automatically. A class only appears here once a teacher has been face-confirmed present for it.</p>
    <table class="table" id="teacher-sessions-table">
        <thead>
            <tr><th>Teacher</th><th>Class</th><th>Subject</th><th>Since</th><th>Status</th><th>Students Sitting</th></tr>
        </thead>
        <tbody id="teacher-sessions-body">
        {% if teacher_sessions %}
            {% for s in teacher_sessions %}
            <tr>
                <td>{{ s.teacher_name or 'Unassigned' }}</td>
                <td>{{ s.class_name }}</td>
                <td>{{ s.subject or '-' }}</td>
                <td>{{ s.started_at }}</td>
                <td>
                    {% if s.teacher_status == 'absent' %}
                        <span class="badge badge-absent">Teacher Absent (auto)</span>
                    {% elif s.teacher_status == 'late' %}
                        <span class="badge badge-late">Teacher Late</span>
                    {% else %}
                        <span class="badge badge-present">Present</span>
                    {% endif %}
                </td>
                <td><span class="badge badge-present">{{ s.present_count }} / {{ s.total_students }}</span></td>
            </tr>
            {% endfor %}
        {% else %}
            <tr><td colspan="6" class="muted">No teacher is currently present in any class.</td></tr>
        {% endif %}
        </tbody>
    </table>
</div>

<script>
function renderTeacherSessions(sessions) {
    const body = document.getElementById('teacher-sessions-body');
    if (!sessions.length) {
        body.innerHTML = '<tr><td colspan="6" class="muted">No teacher is currently present in any class.</td></tr>';
        return;
    }
    body.innerHTML = sessions.map(s => {
        let statusBadge = '<span class="badge badge-present">Present</span>';
        if (s.teacher_status === 'absent') statusBadge = '<span class="badge badge-absent">Teacher Absent (auto)</span>';
        else if (s.teacher_status === 'late') statusBadge = '<span class="badge badge-late">Teacher Late</span>';
        return `
        <tr>
            <td>${s.teacher_name || 'Unassigned'}</td>
            <td>${s.class_name}</td>
            <td>${s.subject || '-'}</td>
            <td>${s.started_at}</td>
            <td>${statusBadge}</td>
            <td><span class="badge badge-present">${s.present_count} / ${s.total_students}</span></td>
        </tr>
    `;
    }).join('');
}

function pollTeacherSessions() {
    fetch('/api/teacher-sessions')
        .then(r => r.json())
        .then(renderTeacherSessions)
        .catch(() => {});
}

setInterval(pollTeacherSessions, 6000);
</script>

<form method="GET" class="inline-form">
    <select name="class_id" onchange="this.form.submit()">
        {% for c in classes %}
        <option value="{{ c.id }}" {% if selected_class == c.id|string %}selected{% endif %}>{{ c.name }}</option>
        {% endfor %}
    </select>
    <a href="{{ url_for('timetable', class_id=selected_class) }}" class="btn btn-secondary">Edit Timetable</a>
</form>

{% if not model_trained or not teacher_model_trained %}
<div class="flash flash-warning">
    {% if not teacher_model_trained %}You need to train the <a href="{{ url_for('teachers') }}">teacher recognition model</a> first. {% endif %}
    {% if not model_trained %}You need to train the <a href="{{ url_for('face_setup') }}">student recognition model</a> first.{% endif %}
</div>
{% elif not classes %}
<div class="flash flash-warning">Add a class first.</div>
{% else %}

<div style="display:flex; gap:24px; flex-wrap:wrap;">
    <div class="panel" style="flex:1; min-width:340px;">
        <div id="period-banner" class="panel" style="background:#eef2ff; margin-bottom:16px;">
            <p class="muted">Checking current period...</p>
        </div>

        <div style="position:relative; max-width:480px;">
            <video id="video" width="480" height="360" autoplay muted playsinline
                   style="background:#000; border-radius:8px; width:100%; max-width:480px; display:block;"></video>
            <canvas id="overlay" width="480" height="360"
                    style="position:absolute; top:0; left:0; width:100%; max-width:480px; pointer-events:none;"></canvas>
            <canvas id="capture-canvas" width="480" height="360" style="display:none;"></canvas>
        </div>
        <p id="status-text" class="muted" style="margin-top:10px;">Click "Start Camera" to begin.</p>
        <button id="start-btn" class="btn btn-primary">Start Camera</button>
        <button id="stop-btn" class="btn btn-secondary" disabled>Stop</button>
        <button id="end-session-btn" class="btn btn-danger" style="display:none;">End Period</button>
        <button id="reset-session-btn" class="btn btn-secondary" style="display:none;" title="Testing only: deletes today's session for this period so the camera waits for the teacher again">Reset Test Session</button>
    </div>

    <div class="panel" style="flex:1; min-width:280px;">
        <h3 id="roster-title">Roster</h3>
        <table class="table" id="roster-table">
            <thead><tr><th>Roll No</th><th>Name</th><th>Status</th></tr></thead>
            <tbody id="roster-body">
                <tr><td colspan="3" class="muted">Waiting for a period to start...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<script>
const classId = "{{ selected_class }}";
const gracePeriodMinutes = {{ auto_absent_grace_minutes }};

const video = document.getElementById('video');
const overlay = document.getElementById('overlay');
const overlayCtx = overlay.getContext('2d');
const captureCanvas = document.getElementById('capture-canvas');
const captureCtx = captureCanvas.getContext('2d');
const startBtn = document.getElementById('start-btn');
const stopBtn = document.getElementById('stop-btn');
const endSessionBtn = document.getElementById('end-session-btn');
const resetSessionBtn = document.getElementById('reset-session-btn');
const statusText = document.getElementById('status-text');
const periodBanner = document.getElementById('period-banner');
const rosterTitle = document.getElementById('roster-title');
const rosterBody = document.getElementById('roster-body');

let stream = null;
let workTimer = null;
let stateTimer = null;
let currentPeriod = null;
let currentSession = null; // {id, teacher_name, subject}
let mode = 'idle'; // idle | awaiting_teacher | marking_students

function renderBanner() {
    if (!currentPeriod) {
        periodBanner.innerHTML = '<p class="muted">No period scheduled right now.</p>';
        return;
    }
    if (currentPeriod.period_type === 'break') {
        periodBanner.innerHTML = `<p>☕ <strong>${currentPeriod.subject || 'Break'}</strong> (${currentPeriod.start_time}–${currentPeriod.end_time}) — no attendance during breaks.</p>`;
        return;
    }
    if (currentSession) {
        let statusLine = `<p>👩‍🏫 Teacher: <strong>${currentSession.teacher_name || 'Not yet confirmed'}</strong></p>`;
        if (currentSession.teacher_status === 'absent') {
            statusLine = `<p>🚫 <strong style="color:#b3261e;">Teacher marked Absent</strong> — grace period elapsed, camera is now scanning and marking student faces directly.</p>`;
        } else if (currentSession.teacher_status === 'late') {
            statusLine = `<p>⏰ <strong style="color:#92600a;">Teacher: ${currentSession.teacher_name}</strong> (arrived late — students the camera already recognized stay marked)</p>`;
        }
        periodBanner.innerHTML = `
            <p>📘 <strong>${currentSession.subject || 'Period ' + currentPeriod.period_number}</strong>
               (${currentPeriod.start_time}–${currentPeriod.end_time})</p>
            ${statusLine}
            <p>✅ Present: <strong>${currentSession.present_count ?? 0} / ${currentSession.total_students ?? '?'}</strong></p>
        `;
    } else {
        periodBanner.innerHTML = `
            <p>📘 <strong>${currentPeriod.subject || 'Period ' + currentPeriod.period_number}</strong>
               (${currentPeriod.start_time}–${currentPeriod.end_time})</p>
            <p class="muted">Waiting for the teacher to be recognized to start this period...
               Student attendance stays locked until then — nobody is marked present without the teacher being face-confirmed first.</p>
        `;
    }
}

function pollState() {
    fetch(`/attendance/smart/state?class_id=${classId}`)
    .then(r => r.json())
    .then(data => {
        currentPeriod = data.period;
        currentSession = data.session;
        renderBanner();

        if (!currentPeriod || currentPeriod.period_type === 'break') {
            mode = 'idle';
            endSessionBtn.style.display = 'none';
            resetSessionBtn.style.display = 'none';
            rosterBody.innerHTML = '<tr><td colspan="3" class="muted">No active period.</td></tr>';
        } else if (currentSession && currentSession.ended_at) {
            // Session already ended (e.g. teacher closed it early) — stop
            // trying to mark students against it. Still show the final
            // roster for reference.
            mode = 'ended';
            endSessionBtn.style.display = 'none';
            resetSessionBtn.style.display = 'inline-block';
            rosterTitle.textContent = `Roster — ${currentSession.subject || ''} (period ended)`;
            loadRoster();
        } else if (currentSession) {
            mode = 'marking_students';
            endSessionBtn.style.display = 'inline-block';
            resetSessionBtn.style.display = 'inline-block';
            rosterTitle.textContent = `Roster — ${currentSession.subject || ''}`;
            loadRoster();
        } else {
            mode = 'awaiting_teacher';
            endSessionBtn.style.display = 'none';
            resetSessionBtn.style.display = 'none';
            rosterBody.innerHTML = '<tr><td colspan="3" class="muted">Point the camera at the teacher to start this period.</td></tr>';
        }
    });
}

function loadRoster() {
    if (!currentSession) return;
    fetch(`/attendance/smart/roster?session_id=${currentSession.id}`)
    .then(r => r.json())
    .then(rows => {
        if (!rows.length) {
            rosterBody.innerHTML = '<tr><td colspan="3" class="muted">No students in this class.</td></tr>';
            return;
        }
        rosterBody.innerHTML = rows.map(s => {
            let badgeClass = 'badge-absent';
            if (s.status === 'Present') badgeClass = 'badge-present';
            return `<tr><td>${s.roll_no}</td><td>${s.name}</td><td><span class="badge ${badgeClass}">${s.status}</span></td></tr>`;
        }).join('');
    });
}

async function startCamera() {
    try {
        stream = await navigator.mediaDevices.getUserMedia({ video: { width: 480, height: 360 }, audio: false });
        video.srcObject = stream;
        startBtn.disabled = true;
        stopBtn.disabled = false;
        statusText.textContent = 'Camera running...';
        workTimer = setInterval(tick, 1500);
    } catch (err) {
        statusText.textContent = 'Could not access camera: ' + err.message;
    }
}

function stopCamera() {
    clearInterval(workTimer);
    if (stream) stream.getTracks().forEach(t => t.stop());
    overlayCtx.clearRect(0, 0, overlay.width, overlay.height);
    startBtn.disabled = false;
    stopBtn.disabled = true;
    statusText.textContent = 'Camera stopped.';
}

function drawBoxes(faces) {
    overlayCtx.clearRect(0, 0, overlay.width, overlay.height);
    (faces || []).forEach(f => {
        let color = '#f59e0b';
        if (f.status === 'marked') color = '#10b981';
        else if (f.status === 'already_marked') color = '#3b82f6';
        else if (f.status === 'teacher') color = '#8b5cf6'; // recognized as teacher, not marked as a student
        overlayCtx.strokeStyle = color;
        overlayCtx.lineWidth = 3;
        overlayCtx.strokeRect(f.x, f.y, f.w, f.h);
        const label = f.name || 'Unknown';
        overlayCtx.fillStyle = color;
        const textWidth = overlayCtx.measureText(label).width + 10;
        overlayCtx.fillRect(f.x, f.y - 20, textWidth, 20);
        overlayCtx.fillStyle = '#fff';
        overlayCtx.font = '13px sans-serif';
        overlayCtx.fillText(label, f.x + 5, f.y - 5);
    });
}

function tick() {
    if (mode === 'idle') {
        statusText.textContent = 'No class period scheduled right now.';
        return;
    }
    if (mode === 'ended') {
        statusText.textContent = 'This period has ended — attendance is closed.';
        return;
    }
    captureCtx.drawImage(video, 0, 0, captureCanvas.width, captureCanvas.height);
    const dataUrl = captureCanvas.toDataURL('image/jpeg', 0.8);

    if (mode === 'awaiting_teacher') {
        statusText.textContent = 'Looking for the teacher...';
        fetch('/attendance/smart/start_session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ image: dataUrl, class_id: classId })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                statusText.textContent = `Period started — teacher: ${data.teacher_name}${data.note ? ' (' + data.note + ')' : ''}`;
                pollState();
            } else {
                statusText.textContent = data.message || 'Could not identify a teacher yet.';
            }
        });
    } else if (mode === 'marking_students' && currentSession) {
        // If the period auto-opened because nobody was confirmed present yet,
        // keep checking for the teacher's face alongside marking students —
        // a late arrival still gets attached to this session (see
        // smart_start_session's "existing" branch) instead of being ignored.
        if (currentSession.teacher_status === 'absent') {
            fetch('/attendance/smart/start_session', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ image: dataUrl, class_id: classId })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success && data.teacher_name) {
                    statusText.textContent = `Teacher recognized: ${data.teacher_name}${data.note ? ' (' + data.note + ')' : ''}`;
                    pollState();
                }
            });
        }

        statusText.textContent = 'Recognizing students...';
        fetch('/attendance/smart/mark_student', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ image: dataUrl, session_id: currentSession.id })
        })
        .then(r => r.json())
        .then(data => {
            if (!data.success) {
                statusText.textContent = data.message || 'Recognition error.';
                return;
            }
            drawBoxes(data.faces);
            currentSession.present_count = data.present_count;
            currentSession.total_students = data.total_students;
            renderBanner();
            if (data.newly_marked && data.newly_marked.length) loadRoster();
            statusText.textContent = data.faces.length ? `Detected: ${data.faces.map(f => f.name).join(', ')}` : 'No face in frame.';
        });
    }
}

endSessionBtn.addEventListener('click', () => {
    if (!currentSession) return;
    if (!confirm('End this period now?')) return;
    fetch('/attendance/smart/end_session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ session_id: currentSession.id })
    }).then(() => pollState());
});

resetSessionBtn.addEventListener('click', () => {
    if (!confirm("Reset today's session for this period? This deletes any attendance marked so far and makes the camera wait for the teacher again. (Testing only.)")) return;
    fetch('/attendance/smart/reset_session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ class_id: classId })
    })
    .then(r => r.json())
    .then(data => {
        statusText.textContent = data.message || (data.success ? 'Session reset.' : 'Could not reset session.');
        pollState();
    });
});

startBtn.addEventListener('click', startCamera);
stopBtn.addEventListener('click', stopCamera);

pollState();
stateTimer = setInterval(pollState, 5000);
</script>
{% endif %}
{% endblock %}
