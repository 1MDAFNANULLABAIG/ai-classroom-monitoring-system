# AI-Powered Smart Classroom Monitoring System - Production Configuration
PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=false
FLASK_USE_RELOADER=false
JWT_SECRET=super-secret-classroom-jwt-key-2026-ultra-secure-32chars
DATABASE_PATH=attendance.db
WAL_BUSY_TIMEOUT=30000

# Edge AI Engine Configuration
YOLO_MODEL_PATH=yolov8n.pt
YUNET_CONF_THRESHOLD=0.70
SFACE_COSINE_THRESHOLD=0.363
SAMPLES_PER_STUDENT=50
LATE_THRESHOLD_MINUTES=10
AUTO_MARK_ABSENT=true

# Public URLs (When deployed to Vercel + Render or Edge Cloudflare Tunnel)
# VITE_API_URL=https://your-backend.onrender.com/api
# VITE_WS_URL=wss://your-backend.onrender.com/ws/classroom
