# AI-Powered Smart Classroom Monitoring System - Production Environment Configuration
# Render automatically injects PORT (e.g. 10000)

PORT=10000
HOST=0.0.0.0
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_USE_RELOADER=false

# Security & Authentication (Required on Render)
JWT_SECRET=super-secret-classroom-jwt-key-2026-ultra-secure-32chars

# Database & SQLite WAL Settings
DATABASE_PATH=attendance.db
WAL_BUSY_TIMEOUT=30000

# Edge AI Engine Sensitivity & Thresholds
YOLO_MODEL_PATH=yolov8n.pt
YUNET_CONF_THRESHOLD=0.70
SFACE_COSINE_THRESHOLD=0.363
SAMPLES_PER_STUDENT=50
LATE_THRESHOLD_MINUTES=10
AUTO_MARK_ABSENT=true
